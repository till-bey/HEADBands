# Secrets & Environment Variables (NEVER commit credentials)
.env
.env.*
!.env.example
*credentials*.json
*service-account*.json
*keyfile*.json
*.pem
*.key
*.p12

# Audio Recordings & Personal Data (Privacy by default)
*.wav
*.pcm
*.raw
*.mp3
*.flac
*.ogg
*.opus
*.webm
*.m4a
data/benchmarks/audio/*
!data/benchmarks/audio/.gitkeep
data/benchmarks/results/*.json
!data/benchmarks/results/.gitkeep

# Model Weights & Checkpoints (NEVER commit weights)
*.onnx
*.onnx.json
*.bin
*.pt
*.pth
*.safetensors
*.ckpt
*.gguf
models/
.cache/
huggingface_cache/

