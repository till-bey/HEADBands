# ==============================================================================
# Swiss Multilingual Voice & Robotics Assistant (.env.example)
# Primary Cloud: GCP | Primary Region: europe-west6 (Zurich) | Hardware: CPU-only
# NEVER place real secrets or API keys in this file. Use Secret Manager in prod.
# ==============================================================================

# General
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080"]
SERVE_FRONTEND=true

# GCP Infrastructure & Regional Routing
# Note: Cloud Run, Artifact Registry, Firestore, GCS, Pub/Sub, Secret Manager run in europe-west6 (Zurich).
# Managed STT/TTS use EU multi-region endpoints; Gemini 3 Flash Preview & Gemini Robotics ER 2
# use Vertex AI's global endpoint (configurable via GCP_LLM_LOCATION if regional GA models are enabled).
GCP_PROJECT_ID=
GCP_REGION=europe-west6
GCP_LOCATION=europe-west6
GCP_LLM_LOCATION=global
GCP_ROBOTICS_LOCATION=global
GCP_STT_LOCATION=eu
GCP_TTS_LOCATION=eu

# Speech-to-Text (STT)
# Providers: google | faster_whisper | mock
STT_DEFAULT_PROVIDER=google
STT_SWISS_GERMAN_PROVIDER=faster_whisper
STT_STANDARD_DE_PROVIDER=google
STT_STANDARD_DE_LANGUAGE=de-DE
STT_STANDARD_DE_MODEL=chirp_3
STT_FR_PROVIDER=google
STT_FR_LANGUAGE=fr-FR
STT_FRENCH_MODEL=chirp_3
STT_EN_PROVIDER=google
STT_EN_LANGUAGE=en-US
STT_ENGLISH_MODEL=chirp_3
STT_ES_PROVIDER=google
STT_ES_LANGUAGE=es-ES
STT_SPANISH_MODEL=chirp_3
STT_CS_PROVIDER=google
STT_CS_LANGUAGE=cs-CZ
STT_CZECH_MODEL=chirp_3
STT_ZH_PROVIDER=google
STT_ZH_LANGUAGE=cmn-Hans-CN
STT_CHINESE_MODEL=chirp_3
STT_DE_CH_MODEL=long

# Swiss German Self-Hosted ASR (CPU-only int8 adaptation — no GPU required)
# If ASR_ENDPOINT is set, FasterWhisperProvider delegates to the private Cloud Run / Docker ASR service.
# If ASR_ENDPOINT is empty, FasterWhisperProvider loads faster-whisper locally on CPU (int8).
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
ASR_ENDPOINT=
ASR_AUTH_ENABLED=false
ASR_TIMEOUT_SECONDS=30.0

# Text-to-Speech (TTS)
# Providers: google | piper | mock
TTS_DEFAULT_PROVIDER=google
TTS_SWISS_GERMAN_PROVIDER=piper
TTS_SPEAKING_RATE=1.0

# Swiss German Piper TTS (d41k4n/piper-swissdial — CC BY-NC 4.0 non-commercial license!)
# Dialects: ag | be | bs | gr | lu | sg | vs (Wallisertiitsch / Leukerbad) | zh
PIPER_MODELS_DIR=./models/piper
PIPER_MODEL_PATH=
PIPER_CONFIG_PATH=
PIPER_DEFAULT_DIALECT=vs
# Must be explicitly true ONLY in non-commercial development/research environments.
# Automatically blocked when APP_ENV=production unless replaced with a commercial model.
ALLOW_NON_COMMERCIAL_MODELS=true

# Google Cloud TTS Voices (EU endpoint)
GOOGLE_TTS_LANGUAGE_DE=de-DE
GOOGLE_TTS_LANGUAGE_FR=fr-FR
GOOGLE_TTS_LANGUAGE_EN=en-US
GOOGLE_TTS_LANGUAGE_ES=es-ES
GOOGLE_TTS_LANGUAGE_CS=cs-CZ
GOOGLE_TTS_LANGUAGE_ZH=cmn-CN
GOOGLE_TTS_VOICE_DE=de-DE-Neural2-F
GOOGLE_TTS_VOICE_FR=fr-FR-Chirp3-HD-Zephyr
GOOGLE_TTS_VOICE_EN=en-US-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_ES=es-ES-Neural2-A
GOOGLE_TTS_VOICE_CS=cs-CZ-Wavenet-A
GOOGLE_TTS_VOICE_ZH=cmn-CN-Chirp3-HD-Aoede

# Main Assistant LLM (Vertex AI Gemini via google-genai SDK)
# Providers: google | mock
LLM_PROVIDER=google
GEMINI_MODEL=gemini-3-flash-preview

# Robotics Integration (Gemini Robotics ER 2 + ROS 2 Safety Gateway)
# Providers: gemini_robotics_er | mock
ROBOTICS_ENABLED=true
ROBOTICS_PROVIDER=gemini_robotics_er
GEMINI_ROBOTICS_MODEL=gemini-robotics-er-2-preview
ROBOT_GATEWAY_URL=
ROBOT_BRIDGE_SHARED_TOKEN=
ROBOT_REQUIRE_CONFIRMATION=true
ROBOT_COMMAND_TTL_SECONDS=30
ROBOT_WATCHDOG_TIMEOUT_SECONDS=10.0
ROBOT_MAX_LINEAR_SPEED_MPS=0.5
ROBOT_MAX_ANGULAR_SPEED_RPS=1.0
ROBOT_MAX_WORKSPACE_RADIUS_M=10.0

# Optional Privacy-Safe Storage, Database & Messaging
AUDIO_STORAGE_ENABLED=false
AUDIO_RETENTION_DAYS=1
GCS_AUDIO_BUCKET=

FIRESTORE_ENABLED=false
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=conversations

PUBSUB_ENABLED=false
PUBSUB_TELEMETRY_TOPIC=robot-telemetry

SECRET_MANAGER_ENABLED=false
API_AUTH_TOKEN=
