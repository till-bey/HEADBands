Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Frisbee prediction
      Enabled: true
      Topic:
        Value: /frisbee/markers
    - Class: rviz_default_plugins/Image
      Name: Detections
      Enabled: true
      Topic:
        Value: /frisbee/debug/detections
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Interception
      Enabled: true
      Topic:
        Value: /frisbee/debug/intercept
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: body_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Focal Point: {X: 0.5, Y: 0.0, Z: 0.0}
      Pitch: 0.4
      Yaw: 3.6
