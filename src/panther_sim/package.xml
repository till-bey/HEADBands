<?xml version="1.0"?>
<package format="3">
  <name>panther_sim</name>
  <version>0.0.1</version>
  <description>Panther arms, head, lift and grippers on ros2_control mock hardware, with the robot's names.</description>
  <maintainer email="headbands@localhost">HEADBands</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>panther_examples</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>unix_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>mock_components</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_joint_trajectory_controller</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
